# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
out/
.static-build-stash/
.DS_Store
tsconfig.tsbuildinfo

# Local package-manager caches / binaries (never commit)
.pnpm-store/
.tools/

# SRD build cache (committed output is lib/srd/seed-data/)
data/srd-source/
data/*.pdf

# Generated at build time (pnpm icons:manifest / build:static)
public/icons/manifest.json

# Working card-art masters (PHB/Eberron/Ravenloft packs must not be committed)
scripts/graphics/

# Full-res page background sources (WebP outputs in public/ are committed)
scripts/page-bg-sources/*
!scripts/page-bg-sources/README.md
!scripts/page-bg-sources/.gitkeep

# Full-res compendium card sources (optimized outputs: only SRD / Kibbles / Mage Hand Press)
scripts/class-card-sources/*
!scripts/class-card-sources/README.md
!scripts/class-card-sources/.gitkeep
scripts/subclass-card-sources/*
!scripts/subclass-card-sources/README.md
!scripts/subclass-card-sources/.gitkeep
scripts/background-card-sources/*
!scripts/background-card-sources/README.md
!scripts/background-card-sources/.gitkeep
scripts/species-card-sources/*
!scripts/species-card-sources/README.md
!scripts/species-card-sources/.gitkeep
scripts/spell-card-sources/*
!scripts/spell-card-sources/README.md
!scripts/spell-card-sources/.gitkeep

# Non-bundled origin folders (PHB, settings books, extras) — never commit, even if
# someone later un-ignores the drop folders above. Keep SRD / kibbles / magehandpress.
scripts/**/PHB/
scripts/**/phb/
scripts/**/WotC/
scripts/**/wotc/
scripts/**/extra/
scripts/**/eberron/
scripts/**/Eberron/
scripts/**/faerun/
scripts/**/Faerun/
scripts/**/ravenloft/
scripts/**/Ravenloft/
scripts/**/Ravenloft-Astarion/
scripts/**/Planescape/
scripts/**/acrana unleashed/
scripts/**/Arcana Unleashed/
scripts/**/acrana/
scripts/**/lorwyn/
scripts/**/motm/
scripts/**/spelljammer/
scripts/**/Planescape/

# Presence manifest for local-only portraits (written by images:optimize; never commit)
public/images/compendium/local-available-card-art.json

# Optimized card art: ignore local-only portraits, then re-include bundled SRD / Kibbles / MHP.
public/images/compendium/classes/artificer.png

public/images/compendium/backgrounds/*
!public/images/compendium/backgrounds/acolyte.png
!public/images/compendium/backgrounds/apothecary.png
!public/images/compendium/backgrounds/criminal.png
!public/images/compendium/backgrounds/engineer.png
!public/images/compendium/backgrounds/sage.png
!public/images/compendium/backgrounds/soldier.png
!public/images/compendium/backgrounds/tinker.png

